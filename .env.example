# ==================================================
# OptigoAI — Environment Variables
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==================================================

# ---- Application ----
APP_NAME=OptigoAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=optigoai
POSTGRES_PASSWORD=optigoai_dev_password
POSTGRES_DB=optigoai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://optigoai:optigoai_dev_password@db:5432/optigoai
DATABASE_URL_SYNC=postgresql://optigoai:optigoai_dev_password@db:5432/optigoai

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Authentication (JWT) ----
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Provider (Google Gemini) ----
# Get your API key from: https://aistudio.google.com/apikey
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# ---- Google Search Console (OAuth 2.0) ----
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add Search Console API scope: https://www.googleapis.com/auth/webmasters.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/search-console/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=OPTIGOAI_SECRET_KEY_FOR_OAUTH_TOKEN_ENCRYPTION_32B

# ---- SERP / SEO Providers (Interchangeable) ----
# Supported providers: dataforseo (default), serper, serpapi
SEO_PROVIDER=dataforseo

# DataForSEO (Primary / Default) — https://dataforseo.com/
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Serper (Alternative Adapter) — https://serper.dev/
SERPER_API_KEY=

# SerpAPI (Alternative Adapter) — https://serpapi.com/
SERPAPI_API_KEY=

# ---- Website Intelligence & Crawler Engine (SSRF-Protected) ----
# Supported providers: firecrawl (default), beautifulsoup, playwright
WEBSITE_CRAWLER_PROVIDER=firecrawl

# Firecrawl (Primary Managed Crawler) — https://firecrawl.dev/
FIRECRAWL_API_KEY=

# Crawler Safety & Resource Limits
CRAWLER_MAX_PAGES=10
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_MAX_RESPONSE_SIZE_BYTES=5242880

# ---- Storage (Google Cloud Storage) ----
STORAGE_PROVIDER=local
GCS_BUCKET_NAME=optigoai-assets
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcs-service-account.json
LOCAL_STORAGE_PATH=./uploads

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# ---- Admin ----
ADMIN_EMAIL=admin@optigoai.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Logging ----
LOG_LEVEL=INFO
