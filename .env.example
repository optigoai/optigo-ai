# ==================================================
# OptigoAI — Environment Variables
# ==================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ==================================================

# ---- Application ----
APP_NAME=OptigoAI
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
POSTGRES_USER=optigoai
POSTGRES_PASSWORD=optigoai_dev_password
POSTGRES_DB=optigoai
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://optigoai:optigoai_dev_password@db:5432/optigoai
DATABASE_URL_SYNC=postgresql://optigoai:optigoai_dev_password@db:5432/optigoai

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Authentication (JWT) ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- AI Provider (Google Gemini) ----
# Get your API key from: https://aistudio.google.com/apikey
# Required: Yes (for AI features)
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# ---- Storage (Google Cloud Storage) ----
# Get credentials from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Required: Later (for creative generation)
STORAGE_PROVIDER=gcs
GCS_BUCKET_NAME=optigoai-assets
GCS_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcs-service-account.json

# ---- Local Storage Fallback ----
# Used when STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./uploads

# ---- CORS ----
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:5173"]

# ---- Admin ----
ADMIN_EMAIL=admin@optigoai.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=60

# ---- Logging ----
LOG_LEVEL=INFO
